---
// "The Lab": an interactive blueprint of a workshop. Every object is something I built.
// Hover/focus an object to highlight it and show its name; click to open it.
import type { Lang } from '../i18n/ui';
import { profile } from '../data/profile';

interface Props { lang: Lang }
const { lang } = Astro.props;
const en = lang === 'en';
const p = (slug: string) => `/${lang}/projects/${slug}/`;

// label: [text, x, y] — y is the top of the label chip in scene coordinates
const L = {
  snake: { href: p('snake-robot'), text: en ? 'Underwater snake robot' : 'Unterwasser-Schlangenroboter', x: 210, y: 236 },
  bird: { href: p('ornithopter'), text: en ? 'Autonomous ornithopter' : 'Autonomer Ornithopter', x: 600, y: 30 },
  calib: { href: p('calibration-jig'), text: en ? 'Calibration jig' : 'Kalibriervorrichtung', x: 470, y: 196 },
  flash: { href: p('flashing-jig'), text: en ? 'ESP32 flashing jig' : 'ESP32-Flashvorrichtung', x: 588, y: 236 },
  debug: { href: p('debugger-jig'), text: en ? 'Debugger jig' : 'Debug-Vorrichtung', x: 700, y: 300 },
  laptop: { href: profile.github, text: en ? 'Code on GitHub' : 'Code auf GitHub', x: 828, y: 282 },
  gem: { href: p('gem-machine'), text: en ? 'Gem faceting machine' : 'Facettiermaschine', x: 1010, y: 206 },
  mud: { href: p('mudskipper'), text: en ? 'Mudskipper robot' : 'Schlammspringer-Roboter', x: 480, y: 420 },
  boxes: { href: p('packaging'), text: en ? 'Packaging redesign' : 'Verpackungs-Redesign', x: 1112, y: 364 },
  cert: { href: `/${lang}/#publications`, text: en ? 'Publications & awards' : 'Publikationen & Auszeichnungen', x: 980, y: 30 },
  mail: { href: `/${lang}/#contact`, text: en ? 'Contact me' : 'Kontakt', x: 1120, y: 120 },
};
const chipW = (s: string) => Math.round(s.length * 7.2 + 44);
const ext = (href: string) => href.startsWith('http');
---

<div class="lab-wrap">
  <svg class="lab" viewBox="0 0 1200 560" role="group" aria-label={en ? 'Interactive lab: select a machine to open it' : 'Interaktive Werkstatt: Maschine auswählen'}>
    <defs>
      <pattern id="labgrid" width="24" height="24" patternUnits="userSpaceOnUse">
        <path d="M24 0H0V24" fill="none" style="stroke: var(--grid)" />
      </pattern>
      <filter id="glow" x="-30%" y="-30%" width="160%" height="160%">
        <feGaussianBlur stdDeviation="3.2" result="b" />
        <feMerge><feMergeNode in="b" /><feMergeNode in="SourceGraphic" /></feMerge>
      </filter>
      <clipPath id="tankclip"><rect x="62" y="318" width="276" height="160" /></clipPath>
      <path id="flightpath" d="M520 150 C 600 70, 760 70, 800 130 C 840 190, 700 210, 620 170 C 560 140, 470 200, 520 150 Z" />
    </defs>

    <rect width="1200" height="560" fill="url(#labgrid)" />
    <!-- room -->
    <g class="room">
      <line x1="20" y1="500" x2="1180" y2="500" />
      <line x1="20" y1="508" x2="1180" y2="508" stroke-dasharray="2 8" />
      <text x="24" y="530" class="dim">ANUSHIKA'S LAB · SCALE 1:20 · SHEET 01</text>
      <text x="1176" y="530" class="dim" text-anchor="end">{en ? 'HOVER OR TAP AN OBJECT' : 'OBJEKT ANTIPPEN ODER ANFAHREN'}</text>
    </g>

    <!-- ===== Snake robot in water tank ===== -->
    <a href={L.snake.href} data-k="snake" class="obj" aria-label={L.snake.text}>
      <rect class="hit" x="50" y="290" width="300" height="210" />
      <path d="M60 300 V480 H340 V300" />
      <line x1="52" y1="300" x2="68" y2="300" /><line x1="332" y1="300" x2="348" y2="300" />
      <path class="water" d="M62 330 q17 -6 34 0 t34 0 t34 0 t34 0 t34 0 t34 0 t34 0 t34 0" />
      <g clip-path="url(#tankclip)">
        <g class="bubbles">
          <circle cx="110" cy="470" r="3" /><circle cx="180" cy="470" r="2" /><circle cx="250" cy="470" r="2.5" /><circle cx="300" cy="470" r="2" />
        </g>
        <g id="lab-snake"></g>
      </g>
      <line x1="80" y1="480" x2="80" y2="500" /><line x1="320" y1="480" x2="320" y2="500" />
      <text x="70" y="315" class="tag">TANK · H₂O</text>
    </a>

    <!-- ===== Mudskipper robot crawling under the bench ===== -->
    <a href={L.mud.href} data-k="mud" class="obj" aria-label={L.mud.text}>
      <g id="lab-mud" transform="translate(480 498)">
        <g class="mud-body">
          <rect class="hit" x="-50" y="-40" width="92" height="44" />
          <g class="arm a1"><path d="M6 -5 L18 1 L30 -1" /></g>
          <path d="M-34 -3 L-22 -12 L12 -12 L16 -2 L-32 -2 Z" />
          <path d="M-30 -8 L-46 -28 L-38 -29 L-25 -11" />
          <rect x="4" y="-32" width="22" height="22" rx="2" />
          <circle cx="11" cy="-24" r="3" /><circle cx="20" cy="-24" r="3" />
          <circle cx="15.5" cy="-15" r="1.4" class="dot" />
          <rect x="-12" y="-16" width="8" height="4" class="solid" />
          <g class="arm a2"><path d="M8 -4 L20 3 L32 1" /></g>
        </g>
      </g>
    </a>

    <!-- ===== Ornithopter flying a loop ===== -->
    <a href={L.bird.href} data-k="bird" class="obj" aria-label={L.bird.text}>
      <use href="#flightpath" class="flightpath" />
      <g class="bird">
        <animateMotion dur="14s" repeatCount="indefinite" rotate="0"><mpath href="#flightpath" /></animateMotion>
        <rect class="hit" x="-62" y="-36" width="124" height="80" />
        <g class="wing wl"><path d="M-4 -6 L-30 -16 L-58 -6 Q-36 12 -4 12 Z" /><path d="M-30 -16 L-22 6" class="rib" /></g>
        <g class="wing wr"><path d="M4 -6 L30 -16 L58 -6 Q36 12 4 12 Z" /><path d="M30 -16 L22 6" class="rib" /></g>
        <ellipse cx="0" cy="2" rx="5" ry="16" class="solid" />
        <path d="M0 18 V28 M-14 38 H14 L0 28 Z" />
        <circle cx="0" cy="-8" r="1.6" class="dot" />
      </g>
    </a>

    <!-- ===== Workbench ===== -->
    <g class="room">
      <rect x="410" y="392" width="500" height="12" />
      <line x1="428" y1="404" x2="428" y2="500" /><line x1="892" y1="404" x2="892" y2="500" />
    </g>

    <!-- Calibration jig -->
    <a href={L.calib.href} data-k="calib" class="obj" aria-label={L.calib.text}>
      <rect class="hit" x="428" y="236" width="88" height="156" />
      <rect x="436" y="246" width="72" height="34" rx="3" />
      <rect x="442" y="252" width="44" height="22" class="screen" />
      <circle cx="497" cy="263" r="5" class="estop" />
      <path d="M440 280 V392 M504 280 V392" />
      <g class="calib-press"><line x1="472" y1="280" x2="472" y2="310" /><circle cx="472" cy="318" r="8" /></g>
      <rect x="452" y="332" width="40" height="5" />
      <rect x="446" y="350" width="52" height="8" /><rect x="446" y="362" width="52" height="8" /><rect x="446" y="374" width="52" height="8" />
    </a>

    <!-- Flashing jig -->
    <a href={L.flash.href} data-k="flash" class="obj" aria-label={L.flash.text}>
      <rect class="hit" x="530" y="276" width="120" height="116" />
      <rect x="538" y="366" width="104" height="26" />
      <rect x="546" y="372" width="26" height="12" class="screen" />
      <rect x="538" y="286" width="10" height="80" />
      <rect x="538" y="286" width="72" height="8" />
      <g class="flash-plate">
        <line x1="584" y1="294" x2="584" y2="330" />
        <rect x="560" y="330" width="58" height="5" />
        <path d="M566 335 v8 M576 335 v8 M586 335 v8 M596 335 v8 M606 335 v8" />
      </g>
      <rect x="560" y="356" width="64" height="4" />
      <g class="flash-lever"><line x1="594" y1="286" x2="636" y2="262" /><circle cx="636" cy="262" r="4" /></g>
      <circle cx="630" cy="378" r="3" class="led" />
    </a>

    <!-- Debugger jig -->
    <a href={L.debug.href} data-k="debug" class="obj" aria-label={L.debug.text}>
      <rect class="hit" x="664" y="336" width="94" height="56" />
      <path d="M670 392 L676 350 H748 L754 392 Z" />
      <rect x="684" y="356" width="44" height="16" class="screen" />
      <line x1="688" y1="362" x2="716" y2="362" class="lcd" /><line x1="688" y1="367" x2="708" y2="367" class="lcd l2" />
      <circle cx="740" cy="362" r="4" />
      <rect x="754" y="374" width="18" height="6" class="solid" />
    </a>

    <!-- Laptop -> GitHub -->
    <a href={L.laptop.href} data-k="laptop" class="obj" aria-label={L.laptop.text} target={ext(L.laptop.href) ? '_blank' : undefined} rel="noopener">
      <rect class="hit" x="780" y="316" width="112" height="76" />
      <path d="M792 382 V322 H880 V382" />
      <path d="M780 382 H892 L886 392 H786 Z" />
      <text x="800" y="342" class="code">&lt;/&gt;</text>
      <line x1="800" y1="352" x2="852" y2="352" class="type t1" />
      <line x1="806" y1="360" x2="866" y2="360" class="type t2" />
      <line x1="806" y1="368" x2="838" y2="368" class="type t3" />
    </a>

    <!-- Gem faceting machine -->
    <a href={L.gem.href} data-k="gem" class="obj" aria-label={L.gem.text}>
      <rect class="hit" x="950" y="246" width="128" height="254" />
      <path d="M972 500 V380 H1056 V500" />
      <rect x="964" y="368" width="100" height="12" />
      <line x1="1014" y1="368" x2="1014" y2="330" />
      <g class="dial">
        <circle cx="1014" cy="300" r="34" stroke-dasharray="2 4" />
        <circle cx="1014" cy="300" r="26" />
        <line x1="1014" y1="300" x2="1014" y2="276" />
      </g>
      <path class="gem" d="M998 296 L1004 288 H1024 L1030 296 L1014 316 Z M998 296 H1030 M1004 288 L1009 296 L1014 288 L1019 296 L1024 288" />
      <text x="1072" y="304" class="tag">1–360°</text>
    </a>

    <!-- Packaging boxes -->
    <a href={L.boxes.href} data-k="boxes" class="obj" aria-label={L.boxes.text}>
      <rect class="hit" x="1088" y="410" width="96" height="90" />
      <rect x="1094" y="456" width="84" height="44" />
      <rect x="1104" y="416" width="64" height="40" />
      <path d="M1094 478 H1178 M1136 416 V456" stroke-dasharray="3 4" />
      <text x="1110" y="442" class="tag">HC84</text>
    </a>

    <!-- Certificate + paper on the wall -->
    <a href={L.cert.href} data-k="cert" class="obj" aria-label={L.cert.text}>
      <rect class="hit" x="950" y="70" width="140" height="120" />
      <rect x="958" y="80" width="76" height="98" />
      <line x1="970" y1="98" x2="1022" y2="98" /><line x1="970" y1="110" x2="1012" y2="110" /><line x1="970" y1="120" x2="1018" y2="120" />
      <circle cx="1010" cy="152" r="10" /><path d="M1004 160 l-4 14 l10 -6 l10 6 l-4 -14" />
      <rect x="1046" y="96" width="38" height="50" />
      <text x="1050" y="114" class="tag">IEEE</text>
      <line x1="1052" y1="124" x2="1078" y2="124" /><line x1="1052" y1="132" x2="1072" y2="132" />
    </a>

    <!-- Envelope pinned to the wall -->
    <a href={L.mail.href} data-k="mail" class="obj" aria-label={L.mail.text}>
      <rect class="hit" x="1104" y="150" width="70" height="60" />
      <g class="env">
        <rect x="1112" y="164" width="54" height="36" />
        <path d="M1112 164 L1139 186 L1166 164" />
        <circle cx="1139" cy="160" r="2.5" class="dot" />
      </g>
    </a>

    <!-- Labels (drawn last so they sit on top) -->
    {Object.entries(L).map(([key, o]) => (
      <g class="label" data-for={key} transform={`translate(${Math.min(o.x - chipW(o.text) / 2, 1196 - chipW(o.text))} ${o.y})`}>
        <rect width={chipW(o.text)} height="30" rx="8" />
        <text x="14" y="20">{o.text} →</text>
      </g>
    ))}
  </svg>
</div>
<p class="lab-hint mono">{en ? 'Swipe sideways to see the whole lab' : 'Zur Seite wischen, um die ganze Werkstatt zu sehen'}</p>

<script>
  // Show the matching name chip for the hovered / focused object.
  document.querySelectorAll<SVGAElement>('.lab .obj').forEach((a) => {
    const lbl = document.querySelector(`.lab .label[data-for="${a.dataset.k}"]`);
    const on = () => lbl?.classList.add('on'), off = () => lbl?.classList.remove('on');
    a.addEventListener('mouseenter', on); a.addEventListener('mouseleave', off);
    a.addEventListener('focus', on); a.addEventListener('blur', off);
  });

  // Snake robot swimming in the tank (serpenoid gait, same as the paper).
  const g = document.getElementById('lab-snake');
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (g) {
    const NS = 'http://www.w3.org/2000/svg';
    const N = 9, Lk = 22;
    const links: SVGRectElement[] = [];
    const joints: SVGCircleElement[] = [];
    for (let i = 0; i < N; i++) { const r = document.createElementNS(NS, 'rect'); r.setAttribute('width', String(Lk - 4)); r.setAttribute('height', '9'); r.setAttribute('rx', '4.5'); r.setAttribute('y', '-4.5'); r.style.fill = 'rgba(var(--accent-rgb), 0.06)'; r.style.stroke = 'rgba(var(--accent-rgb), 0.75)'; r.style.strokeWidth = '1.3'; g.appendChild(r); links.push(r); }
    for (let i = 1; i < N; i++) { const c = document.createElementNS(NS, 'circle'); c.setAttribute('r', '2.6'); c.style.fill = 'var(--bg-2)'; c.style.stroke = 'rgba(var(--accent-rgb), 0.85)'; c.style.strokeWidth = '1.2'; g.appendChild(c); joints.push(c); }
    const mud = document.getElementById('lab-mud');
    const mudBody = mud?.querySelector<SVGGElement>('.mud-body');
    const mudLabel = document.querySelector<SVGGElement>('.lab .label[data-for="mud"]');
    const mudChip = mudLabel ? +(mudLabel.querySelector('rect')?.getAttribute('width') ?? 160) : 160;
    let mx = 480, mdir = 1;
    let dir = 1, x = 140;
    const t0 = performance.now();
    let prev = t0;
    const draw = (now: number) => {
      const t = (now - t0) / 1000, dt = Math.min(0.05, (now - prev) / 1000); prev = now;
      if (!reduce) { x += dir * 22 * dt; if (x > 250) dir = -1; if (x < 150) dir = 1; }
      if (!reduce && mud && mudBody) {
        mx += mdir * 26 * dt; if (mx > 850) mdir = -1; if (mx < 470) mdir = 1;
        const bob = Math.abs(Math.sin(t * 3.5)) * 1.5;
        mud.setAttribute('transform', `translate(${mx.toFixed(1)} ${(498 - bob).toFixed(1)})`);
        mudBody.setAttribute('transform', mdir < 0 ? 'scale(-1 1)' : '');
        mudLabel?.setAttribute('transform', `translate(${(mx - mudChip / 2).toFixed(1)} 420)`);
      }
      const y = 410 + Math.sin(t * 0.6) * 18;
      const pts = [{ x: 0, y: 0 }]; let th = 0;
      for (let i = 0; i < N; i++) { if (i) th += 0.45 * Math.sin(2.2 * t + i * 0.8); const q = pts[i]; pts.push({ x: q.x - Lk * Math.cos(th), y: q.y - Lk * Math.sin(th) }); }
      const cx = pts.reduce((s, q) => s + q.x, 0) / pts.length, cy = pts.reduce((s, q) => s + q.y, 0) / pts.length;
      const tail = pts[N], rot = -Math.atan2(pts[0].y - tail.y, pts[0].x - tail.x);
      const P = pts.map((q) => { const a = q.x - cx, b = q.y - cy; return { x: x + dir * (a * Math.cos(rot) - b * Math.sin(rot)), y: y + a * Math.sin(rot) + b * Math.cos(rot) }; });
      for (let i = 0; i < N; i++) {
        const a = P[i], b = P[i + 1], ang = (Math.atan2(b.y - a.y, b.x - a.x) * 180) / Math.PI;
        links[i].setAttribute('transform', `translate(${a.x + (b.x - a.x) * 0.1} ${a.y + (b.y - a.y) * 0.1}) rotate(${ang})`);
      }
      for (let i = 1; i < N; i++) { joints[i - 1].setAttribute('cx', P[i].x.toFixed(1)); joints[i - 1].setAttribute('cy', P[i].y.toFixed(1)); }
      if (!reduce) requestAnimationFrame(draw);
    };
    requestAnimationFrame(draw);
  }
</script>

<style>
  .lab-wrap { overflow-x: auto; border: 1px solid var(--line-soft); border-radius: var(--radius); background: var(--bg-2); scrollbar-width: thin; }
  .lab { display: block; width: 100%; min-width: 820px; height: auto; color: var(--accent); }
  .lab-hint { display: none; margin-top: 12px; font-size: 11px; }
  @media (max-width: 860px) { .lab-hint { display: block; } }

  .lab :global(*) { vector-effect: non-scaling-stroke; }
  .room line, .room rect, .room path { fill: none; stroke: rgba(144, 152, 165, 0.35); stroke-width: 1.2; }
  .dim { font: 500 10px var(--mono); letter-spacing: .1em; fill: var(--faint); }
  .tag { font: 500 9px var(--mono); letter-spacing: .08em; fill: var(--muted); stroke: none !important; }
  .code { font: 600 13px var(--mono); fill: currentColor; stroke: none !important; }

  .obj { cursor: pointer; outline: none; }
  .obj :is(path, rect, line, circle, ellipse, use) { fill: rgba(var(--accent-rgb), 0.04); stroke: rgba(var(--accent-rgb), 0.7); stroke-width: 1.3; transition: stroke .3s, fill .3s; }
  .obj line { fill: none; }
  .obj .hit { fill: transparent; stroke: none !important; }
  .obj .solid { fill: var(--bg-2); }
  .obj .dot { fill: currentColor; stroke: none; }
  .obj .screen { fill: rgba(var(--accent-rgb), 0.08); }
  .obj .estop { fill: rgba(255, 110, 110, 0.25); stroke: rgba(255, 130, 130, 0.7); }
  .obj .water { fill: none; stroke-dasharray: 4 4; animation: wave 3s linear infinite; }
  .obj .flightpath { fill: none; stroke: rgba(var(--accent-rgb), 0.14); stroke-dasharray: 2 6; }
  .obj .rib { fill: none; stroke-dasharray: 2 3; opacity: .6; }
  .obj > * { transition: opacity .35s; }
  .obj, .obj > g { transition: opacity .35s, filter .35s; }

  /* highlight the hovered object, fade the rest */
  .lab:has(.obj:hover, .obj:focus-visible) .obj:not(:hover):not(:focus-visible) { opacity: .28; }
  .obj:hover, .obj:focus-visible { filter: url(#glow); }
  .obj:hover :is(path, rect, line, circle, ellipse):not(.hit), .obj:focus-visible :is(path, rect, line, circle, ellipse):not(.hit) { stroke: var(--accent-hi); }

  .label { pointer-events: none; opacity: 0; transition: opacity .3s, transform .3s; }
  .label rect { fill: var(--bg-2); stroke: rgba(var(--accent-rgb), .6); stroke-width: 1; }
  .label text { font: 600 13px var(--sans); fill: var(--text); }
  .label.on { opacity: 1; }

  /* animations */
  .wing { transform-box: fill-box; animation: flap .32s ease-in-out infinite alternate; }
  .wl { transform-origin: 100% 40%; }
  .wr { transform-origin: 0% 40%; animation-name: flapR; }
  .bubbles circle { animation: bubble 4s linear infinite; fill: none; stroke: rgba(var(--accent-rgb), .5); }
  .bubbles circle:nth-child(2) { animation-delay: 1.2s; } .bubbles circle:nth-child(3) { animation-delay: 2.1s; } .bubbles circle:nth-child(4) { animation-delay: 3s; }
  .calib-press { animation: press 3.6s ease-in-out infinite; }
  .flash-plate { animation: plate 4.2s ease-in-out infinite; }
  .flash-lever { transform-box: view-box; transform-origin: 594px 286px; animation: lever 4.2s ease-in-out infinite; }
  .led { animation: led 4.2s steps(1) infinite; }
  .lcd { stroke-dasharray: 30; animation: type 2.4s steps(6) infinite; }
  .lcd.l2 { animation-delay: .6s; }
  .type { stroke-dasharray: 70; stroke-dashoffset: 70; animation: code 5s ease-in-out infinite; }
  .t2 { animation-delay: .5s; } .t3 { animation-delay: 1s; }
  .dial { transform-box: view-box; transform-origin: 1014px 300px; animation: spin 12s steps(36) infinite; }
  .gem { animation: shine 2.4s ease-in-out infinite; }
  .arm { transform-box: view-box; transform-origin: 7px -5px; animation: crawl .9s ease-in-out infinite alternate; }
  .a2 { animation-delay: -.45s; }
  .mud-body { transition: transform .4s; }
  .env { animation: bob 3s ease-in-out infinite; }

  @keyframes flap { from { transform: rotate(16deg); } to { transform: rotate(-18deg); } }
  @keyframes flapR { from { transform: rotate(-16deg); } to { transform: rotate(18deg); } }
  @keyframes bubble { from { transform: translateY(0); opacity: 0; } 15% { opacity: 1; } to { transform: translateY(-150px); opacity: 0; } }
  @keyframes wave { to { stroke-dashoffset: -16; } }
  @keyframes press { 0%, 20% { transform: translateY(0); } 45%, 65% { transform: translateY(12px); } 90%, 100% { transform: translateY(0); } }
  @keyframes plate { 0%, 15% { transform: translateY(0); } 35%, 70% { transform: translateY(13px); } 90%, 100% { transform: translateY(0); } }
  @keyframes lever { 0%, 15% { transform: rotate(0); } 35%, 70% { transform: rotate(32deg); } 90%, 100% { transform: rotate(0); } }
  @keyframes led { 0% { fill: rgba(var(--accent-rgb), .12); } 38% { fill: rgba(120,230,160,.95); } 70% { fill: rgba(var(--accent-rgb), .12); } }
  @keyframes type { from { stroke-dashoffset: 30; } to { stroke-dashoffset: 0; } }
  @keyframes code { 0% { stroke-dashoffset: 70; } 40%, 80% { stroke-dashoffset: 0; } 100% { stroke-dashoffset: -70; } }
  @keyframes spin { to { transform: rotate(360deg); } }
  @keyframes shine { 0%, 100% { stroke: rgba(var(--accent-rgb), .7); } 50% { stroke: var(--accent-hi); } }
  @keyframes crawl { from { transform: rotate(-10deg); } to { transform: rotate(14deg); } }
