---
// Technical line drawings used where a project has no photo yet.
interface Props { art: 'gem' | 'mudskipper' | 'seal' | 'heatsink' | 'box' | 'snake'; label?: string }
const { art, label } = Astro.props;
---

<svg class="bp" viewBox="0 0 400 260" role="img" aria-label={label ?? art}>
  <defs>
    <pattern id={`g-${art}`} width="20" height="20" patternUnits="userSpaceOnUse">
      <path d="M20 0H0V20" fill="none" style="stroke: var(--grid)" stroke-width="1" />
    </pattern>
  </defs>
  <rect width="400" height="260" fill={`url(#g-${art})`} />
  <g fill="none" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round" stroke-linecap="round">
    {art === 'gem' && (
      <g>
        <circle cx="200" cy="130" r="92" stroke-opacity=".25" stroke-dasharray="2 5" />
        {Array.from({ length: 36 }, (_, i) => {
          const a = (i * Math.PI * 2) / 36;
          const r1 = i % 3 === 0 ? 82 : 87;
          return <line x1={200 + r1 * Math.cos(a)} y1={130 + r1 * Math.sin(a)} x2={200 + 92 * Math.cos(a)} y2={130 + 92 * Math.sin(a)} stroke-opacity=".5" />;
        })}
        <path d="M150 112 L170 88 H230 L250 112 L200 178 Z" />
        <path d="M150 112 H250 M170 88 L185 112 L200 88 L215 112 L230 88 M185 112 L200 178 L215 112" stroke-opacity=".7" />
        <text x="292" y="38" class="t">1 – 360 INDEX</text>
        <path d="M288 42 L262 70" stroke-opacity=".4" />
      </g>
    )}
    {art === 'mudskipper' && (
      <g>
        <path d="M80 150 C110 110 190 100 260 118 C300 128 320 140 330 150 C318 160 300 170 262 178 C190 194 112 186 80 150 Z" />
        <path d="M80 150 L48 126 L56 150 L48 174 Z" />
        <circle cx="292" cy="132" r="9" /><circle cx="292" cy="132" r="3" />
        <path d="M180 108 C190 84 222 80 236 112" stroke-opacity=".7" />
        <path d="M218 180 L206 214 L228 214 M250 176 L246 210 L268 212" />
        <path d="M100 150 H316" stroke-dasharray="3 5" stroke-opacity=".35" />
        <text x="276" y="74" class="t">ESP32-CAM</text>
        <path d="M290 80 L292 118" stroke-opacity=".4" />
      </g>
    )}
    {art === 'seal' && (
      <g>
        <path d="M90 70 H310 V200 H90 Z" />
        <path d="M110 90 H290 V180 H110 Z" stroke-opacity=".5" />
        <path d="M180 70 V40 H220 V70" />
        <ellipse cx="200" cy="70" rx="34" ry="8" stroke-opacity=".9" />
        <ellipse cx="200" cy="70" rx="26" ry="5" stroke-opacity=".5" />
        <path d="M200 40 V22 M188 22 H212" stroke-opacity=".7" />
        <path d="M200 120 V160 M186 160 H214" stroke-dasharray="3 4" stroke-opacity=".6" />
        <text x="250" y="40" class="t">IP68 · CAST SILICONE</text>
        <path d="M248 44 L232 66" stroke-opacity=".4" />
      </g>
    )}
    {art === 'heatsink' && (
      <g>
        <path d="M90 180 H310 V196 H90 Z" />
        {Array.from({ length: 11 }, (_, i) => <path d={`M${100 + i * 20} 180 V${92 + (i % 2) * 6} H${108 + i * 20} V180`} />)}
        {[0, 1, 2].map((k) => <path d={`M${150 + k * 50} 84 C${140 + k * 50} 70 ${160 + k * 50} 60 ${150 + k * 50} 44`} stroke-opacity=".45" stroke-dasharray="3 4" />)}
        <text x="272" y="56" class="t">≈ −50 % HEAT</text>
      </g>
    )}
    {art === 'box' && (
      <g>
        <path d="M120 110 L200 70 L290 106 L210 148 Z" />
        <path d="M120 110 V190 L210 230 V148 M210 230 L290 188 V106" />
        <path d="M200 70 V82" stroke-opacity=".4" />
        <path d="M108 116 V196" stroke-opacity=".45" /><path d="M104 116 H112 M104 196 H112" stroke-opacity=".45" />
        <path d="M300 112 L222 154" stroke-opacity=".3" stroke-dasharray="3 4" />
        <text x="44" y="160" class="t">−37 % VOL</text>
        <text x="300" y="214" class="t">−63 % COST</text>
      </g>
    )}
    {art === 'snake' && (
      <g>
        {Array.from({ length: 9 }, (_, i) => {
          const x = 52 + i * 34; const y = 130 + 26 * Math.sin(i * 0.8);
          return <rect x={x} y={y - 9} width="28" height="18" rx="9" />;
        })}
      </g>
    )}
  </g>
</svg>

<style>
  .bp { width: 100%; height: 100%; color: var(--accent); background: var(--bg-2); }
  .bp :global(.t) { font-family: var(--mono); font-size: 10px; letter-spacing: .08em; fill: var(--muted); stroke: none; }
</style>
