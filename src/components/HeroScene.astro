---
// Interactive blueprint scene for the home page.
// Three line-drawn machines: underwater snake robot, flapping-wing ornithopter, production jig.
// Hover (or tap once on phones) to highlight one and show its name; click (or tap again) to open it.
import type { Lang } from '../i18n/ui';

interface Props { lang: Lang }
const { lang } = Astro.props;

const objects = {
  snake: {
    href: `/${lang}/projects/snake-robot/`,
    title: lang === 'en' ? 'Underwater Snake Robot' : 'Unterwasser-Schlangenroboter',
    sub: lang === 'en' ? 'Research · IEEE ICEEET 2026' : 'Forschung · IEEE ICEEET 2026',
  },
  bird: {
    href: `/${lang}/projects/ornithopter/`,
    title: lang === 'en' ? 'Autonomous Ornithopter' : 'Autonomer Ornithopter',
    sub: lang === 'en' ? 'Flapping-wing flight · no GPS' : 'Schlagflügelflug · ohne GPS',
  },
  jig: {
    href: `/${lang}/#industry`,
    title: lang === 'en' ? 'Production Jigs' : 'Fertigungsvorrichtungen',
    sub: lang === 'en' ? 'Industry · Atlas Labs' : 'Industrie · Atlas Labs',
  },
};
const hint = lang === 'en' ? 'Hover a machine to explore' : 'Maschine anfahren zum Erkunden';
---

<canvas class="scene" data-objects={JSON.stringify(objects)} data-hint={hint} aria-hidden="true"></canvas>

<script>
  type Id = 'snake' | 'bird' | 'jig';
  type Box = { x0: number; y0: number; x1: number; y1: number };

  const canvas = document.querySelector<HTMLCanvasElement>('canvas.scene')!;
  const ctx = canvas.getContext('2d')!;
  const meta = JSON.parse(canvas.dataset.objects!) as Record<Id, { href: string; title: string; sub: string }>;
  const hint = canvas.dataset.hint!;
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const IDS: Id[] = ['bird', 'snake', 'jig'];
  const A = '111,183,255';

  let w = 0, h = 0, dpr = 1, running = false, raf = 0;
  const t0 = performance.now();
  let hovered: Id | null = null;          // from pointer
  let external: Id | null = null;         // from the "Explore" links
  const k: Record<Id, number> = { snake: 0, bird: 0, jig: 0 };   // eased highlight 0..1
  const boxes: Partial<Record<Id, Box>> = {};
  let anyK = 0, hintK = 1;
  const particles: { x: number; y: number; r: number; s: number; a: number }[] = [];

  // ---------- layout ----------
  function layout() {
    const mobile = w < 760;
    const vh = window.innerHeight;
    if (mobile) {
      const s = Math.min(w / 390, 1.25);
      return {
        mobile, s,
        bird: { x: w * 0.3, y: Math.min(vh * 0.13, h * 0.16), span: 150 * s },
        jig: { x: w * 0.76, y: Math.min(vh * 0.16, h * 0.2), size: 0.62 * s },
        snake: { x: w * 0.5, y: Math.min(vh * 0.33, h * 0.36), len: w * 0.72 },
      };
    }
    const s = Math.min(w / 1440, 1.2);
    return {
      mobile, s,
      bird: { x: w * 0.77, y: h * 0.27, span: 330 * s },
      jig: { x: w * 0.885, y: h * 0.63, size: 1 * s },
      snake: { x: w * 0.665, y: h * 0.63, len: Math.min(w * 0.25, 380) },
    };
  }

  function resize() {
    const r = canvas.getBoundingClientRect();
    dpr = Math.min(window.devicePixelRatio || 1, 2);
    w = r.width; h = r.height;
    canvas.width = Math.round(w * dpr); canvas.height = Math.round(h * dpr);
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    particles.length = 0;
    const n = Math.round((w * h) / 24000);
    for (let i = 0; i < n; i++) particles.push({ x: Math.random() * w, y: Math.random() * h, r: Math.random() * 1.1 + 0.3, s: Math.random() * 0.4 + 0.15, a: Math.random() * 0.3 + 0.06 });
  }

  // ---------- style helpers ----------
  function style(id: Id) {
    const kk = k[id];
    const dim = anyK * (1 - kk);                  // other objects fade when one is active
    const alpha = (0.62 + 0.38 * kk) * (1 - 0.55 * dim);
    ctx.strokeStyle = `rgba(${A},${alpha})`;
    ctx.lineWidth = 1.2 + 0.5 * kk;
    ctx.shadowColor = `rgba(${A},${0.55 * kk})`;
    ctx.shadowBlur = 14 * kk;
    return { alpha, fill: `rgba(${A},${0.04 + 0.07 * kk})` };
  }
  function noGlow() { ctx.shadowBlur = 0; }
  const boxOf = (pts: { x: number; y: number }[], pad: number): Box => {
    let x0 = Infinity, y0 = Infinity, x1 = -Infinity, y1 = -Infinity;
    for (const p of pts) { x0 = Math.min(x0, p.x); y0 = Math.min(y0, p.y); x1 = Math.max(x1, p.x); y1 = Math.max(y1, p.y); }
    return { x0: x0 - pad, y0: y0 - pad, x1: x1 + pad, y1: y1 + pad };
  };

  function grid() {
    const step = 44;
    ctx.lineWidth = 1;
    for (let x = 0, i = 0; x < w; x += step, i++) { ctx.strokeStyle = i % 5 ? 'rgba(255,255,255,0.022)' : 'rgba(255,255,255,0.045)'; ctx.beginPath(); ctx.moveTo(x + .5, 0); ctx.lineTo(x + .5, h); ctx.stroke(); }
    for (let y = 0, i = 0; y < h; y += step, i++) { ctx.strokeStyle = i % 5 ? 'rgba(255,255,255,0.022)' : 'rgba(255,255,255,0.045)'; ctx.beginPath(); ctx.moveTo(0, y + .5); ctx.lineTo(w, y + .5); ctx.stroke(); }
  }

  // ---------- snake robot ----------
  function capsule(ax: number, ay: number, bx: number, by: number, r: number, fill: string) {
    const len = Math.hypot(bx - ax, by - ay), ang = Math.atan2(by - ay, bx - ax);
    ctx.save(); ctx.translate(ax, ay); ctx.rotate(ang);
    ctx.beginPath(); ctx.moveTo(0, -r); ctx.lineTo(len, -r); ctx.arc(len, 0, r, -Math.PI / 2, Math.PI / 2); ctx.lineTo(0, r); ctx.arc(0, 0, r, Math.PI / 2, 1.5 * Math.PI); ctx.closePath();
    ctx.fillStyle = fill; ctx.fill(); ctx.stroke(); ctx.restore();
  }
  function drawSnake(t: number, c: { x: number; y: number; len: number }) {
    const N = 9, L = c.len / N, r = Math.max(5, L * 0.21);
    const pts = [{ x: 0, y: 0 }]; let th = 0;
    for (let i = 0; i < N; i++) { if (i) th += 0.42 * Math.sin(1.25 * t + i * 0.78); const p = pts[i]; pts.push({ x: p.x - L * Math.cos(th), y: p.y - L * Math.sin(th) }); }
    const cx = pts.reduce((s, p) => s + p.x, 0) / pts.length, cy = pts.reduce((s, p) => s + p.y, 0) / pts.length;
    const tail = pts[N], axis = Math.atan2(pts[0].y - tail.y, pts[0].x - tail.x);
    const rot = -0.1 + 0.05 * Math.sin(t * 0.21) - axis;
    const ay = c.y + Math.sin(t * 0.33) * 8;
    const P = pts.map((p) => { const x = p.x - cx, y = p.y - cy; return { x: c.x + x * Math.cos(rot) - y * Math.sin(rot), y: ay + x * Math.sin(rot) + y * Math.cos(rot) }; });
    const st = style('snake');
    for (let i = 0; i < N; i++) { const a = P[i], b = P[i + 1], gx = (b.x - a.x) * .16, gy = (b.y - a.y) * .16; capsule(a.x + gx, a.y + gy, b.x - gx, b.y - gy, r, st.fill); }
    noGlow();
    for (let i = 1; i < N; i++) {
      ctx.beginPath(); ctx.arc(P[i].x, P[i].y, r * .5, 0, Math.PI * 2); ctx.fillStyle = '#0a0c0f'; ctx.fill(); ctx.stroke();
      ctx.beginPath(); ctx.arc(P[i].x, P[i].y, 1.3, 0, Math.PI * 2); ctx.fillStyle = `rgba(${A},${st.alpha})`; ctx.fill();
    }
    const H = P[0];
    ctx.save(); ctx.globalAlpha = 0.6; ctx.lineWidth = 1;
    ctx.beginPath(); ctx.arc(H.x, H.y, r * 1.8, 0, Math.PI * 2); ctx.moveTo(H.x - r * 2.5, H.y); ctx.lineTo(H.x + r * 2.5, H.y); ctx.moveTo(H.x, H.y - r * 2.5); ctx.lineTo(H.x, H.y + r * 2.5); ctx.stroke(); ctx.restore();
    boxes.snake = boxOf(P, r * 2.6);
  }

  // ---------- ornithopter ----------
  function drawBird(t: number, c: { x: number; y: number; span: number }) {
    const half = c.span / 2;
    const flap = 0.42 * Math.sin(t * 4.2);                 // wing stroke angle
    const bend = 0.5 * Math.sin(t * 4.2 - 0.6);            // outer wing lags
    const x = c.x + Math.sin(t * 0.5) * 6, y = c.y + Math.sin(t * 0.7) * 7 - flap * 6;
    const st = style('bird');
    const pts: { x: number; y: number }[] = [];
    for (const side of [-1, 1]) {
      const sh = { x: x + side * 7, y: y - 10 };
      const a1 = -flap * 1.0, a2 = -(flap + bend * 0.6);
      const mid = { x: sh.x + side * half * 0.48 * Math.cos(a1), y: sh.y + half * 0.48 * Math.sin(a1) };
      const tip = { x: mid.x + side * half * 0.52 * Math.cos(a2), y: mid.y + half * 0.52 * Math.sin(a2) };
      const root = { x: x + side * 6, y: y + 16 };
      ctx.beginPath(); ctx.moveTo(sh.x, sh.y); ctx.lineTo(mid.x, mid.y); ctx.lineTo(tip.x, tip.y);
      ctx.quadraticCurveTo(mid.x + side * 6, mid.y + half * 0.42, root.x, root.y); ctx.closePath();
      ctx.fillStyle = st.fill; ctx.fill(); ctx.stroke();
      // spar ribs
      ctx.save(); ctx.globalAlpha = 0.5; ctx.setLineDash([2, 4]);
      ctx.beginPath(); ctx.moveTo(mid.x, mid.y); ctx.lineTo((mid.x + root.x) / 2 + side * 10, (mid.y + root.y) / 2 + 14); ctx.stroke(); ctx.restore();
      pts.push(tip, mid, sh, root);
    }
    // fuselage, tail
    ctx.beginPath(); ctx.ellipse(x, y + 2, 7, 22, 0, 0, Math.PI * 2); ctx.fillStyle = '#0a0c0f'; ctx.fill(); ctx.stroke();
    ctx.beginPath(); ctx.moveTo(x, y + 24); ctx.lineTo(x, y + 40);
    ctx.moveTo(x - 20, y + 54); ctx.lineTo(x + 20, y + 54); ctx.lineTo(x, y + 40); ctx.closePath(); ctx.fillStyle = st.fill; ctx.fill(); ctx.stroke();
    noGlow();
    ctx.beginPath(); ctx.arc(x, y - 12, 2.2, 0, Math.PI * 2); ctx.fillStyle = `rgba(${A},${st.alpha})`; ctx.fill();
    pts.push({ x: x - 20, y: y + 54 }, { x: x + 20, y: y + 54 }, { x, y: y - 24 });
    boxes.bird = boxOf(pts, 14);
  }

  // ---------- production jig (pogo-pin fixture with toggle clamp) ----------
  function drawJig(t: number, c: { x: number; y: number; size: number }) {
    const s = c.size, X = c.x, Y = c.y;
    const cyc = (t % 4.2) / 4.2;                           // clamp cycle
    const press = cyc < .25 ? cyc / .25 : cyc < .6 ? 1 : cyc < .8 ? 1 - (cyc - .6) / .2 : 0;
    const e = press * press * (3 - 2 * press);             // smoothstep
    const st = style('jig');
    const R = (x: number, y: number, ww: number, hh: number) => { ctx.beginPath(); ctx.rect(X + x * s, Y + y * s, ww * s, hh * s); ctx.fillStyle = st.fill; ctx.fill(); ctx.stroke(); };
    // base + display
    R(-80, 40, 160, 26);
    ctx.beginPath(); ctx.rect(X - 64 * s, Y + 46 * s, 34 * s, 14 * s); ctx.stroke();
    // back column + top arm
    R(-78, -92, 14, 132);
    R(-78, -92, 108, 10);
    // PCB on nest
    R(-34, 32, 92, 6);
    for (let i = 0; i < 5; i++) { ctx.beginPath(); ctx.rect(X + (-26 + i * 17) * s, Y + 28 * s, 8 * s, 4 * s); ctx.stroke(); }
    // plunger + pressure plate with pogo pins
    const dy = e * 22;
    ctx.beginPath(); ctx.moveTo(X + 12 * s, Y - 82 * s); ctx.lineTo(X + 12 * s, Y + (-28 + dy) * s); ctx.stroke();
    R(-30, -28 + dy, 84, 7);
    for (let i = 0; i < 7; i++) {
      const px = X + (-24 + i * 12) * s;
      ctx.beginPath(); ctx.moveTo(px, Y + (-21 + dy) * s); ctx.lineTo(px, Y + (-8 + dy) * s); ctx.stroke();
      ctx.beginPath(); ctx.arc(px, Y + (-7 + dy) * s, 1.4 * s, 0, Math.PI * 2); ctx.stroke();
    }
    // toggle-clamp lever (rotates with press)
    const piv = { x: X + 22 * s, y: Y - 92 * s };
    const ang = -1.05 + e * 0.95;
    const tip = { x: piv.x + Math.cos(ang) * 64 * s, y: piv.y + Math.sin(ang) * 64 * s };
    ctx.beginPath(); ctx.moveTo(piv.x, piv.y); ctx.lineTo(tip.x, tip.y); ctx.stroke();
    ctx.beginPath(); ctx.arc(tip.x, tip.y, 5 * s, 0, Math.PI * 2); ctx.fillStyle = st.fill; ctx.fill(); ctx.stroke();
    ctx.beginPath(); ctx.arc(piv.x, piv.y, 3.5 * s, 0, Math.PI * 2); ctx.fillStyle = '#0a0c0f'; ctx.fill(); ctx.stroke();
    noGlow();
    // status LED: lights while contacting
    ctx.beginPath(); ctx.arc(X + 60 * s, Y + 53 * s, 3 * s, 0, Math.PI * 2);
    ctx.fillStyle = e > 0.95 ? `rgba(120,230,160,${0.5 + 0.5 * st.alpha})` : 'rgba(255,255,255,0.12)'; ctx.fill();
    boxes.jig = { x0: X - 92 * s, y0: Y - 150 * s, x1: X + 96 * s, y1: Y + 76 * s };
  }

  // ---------- label chip ----------
  function label(id: Id) {
    const kk = k[id], b = boxes[id]; if (!b || kk < 0.02) return;
    const m = meta[id];
    ctx.save(); ctx.globalAlpha = kk;
    ctx.font = '600 14px "Inter Variable", system-ui, sans-serif';
    const tw = ctx.measureText(m.title + '  →').width;
    ctx.font = '500 10px "JetBrains Mono", monospace';
    const sw = ctx.measureText(m.sub.toUpperCase()).width;
    const bw = Math.max(tw, sw) + 28, bh = 48;
    let x = (b.x0 + b.x1) / 2 - bw / 2;
    let y = b.y0 - bh - 10 + (1 - kk) * 8;
    x = Math.max(12, Math.min(w - bw - 12, x)); if (y < 12) y = b.y1 + 10;
    ctx.beginPath(); ctx.roundRect(x, y, bw, bh, 10);
    ctx.fillStyle = 'rgba(15,18,22,0.92)'; ctx.fill(); ctx.strokeStyle = `rgba(${A},0.55)`; ctx.lineWidth = 1; ctx.stroke();
    ctx.fillStyle = '#e8eaed'; ctx.font = '600 14px "Inter Variable", system-ui, sans-serif'; ctx.fillText(m.title + '  →', x + 14, y + 21);
    ctx.fillStyle = `rgba(${A},0.9)`; ctx.font = '500 10px "JetBrains Mono", monospace'; ctx.fillText(m.sub.toUpperCase(), x + 14, y + 37);
    // corner ticks around the object
    ctx.strokeStyle = `rgba(${A},0.7)`; const L = 10;
    for (const [cx, cy, sx, sy] of [[b.x0, b.y0, 1, 1], [b.x1, b.y0, -1, 1], [b.x0, b.y1, 1, -1], [b.x1, b.y1, -1, -1]]) {
      ctx.beginPath(); ctx.moveTo(cx + sx * L, cy); ctx.lineTo(cx, cy); ctx.lineTo(cx, cy + sy * L); ctx.stroke();
    }
    ctx.restore();
  }

  // ---------- frame ----------
  function frame(now: number) {
    const t = reduce ? 2.1 : (now - t0) / 1000;
    const active = hovered ?? external;
    for (const id of IDS) k[id] += ((active === id ? 1 : 0) - k[id]) * (reduce ? 1 : 0.14);
    anyK += ((active ? 1 : 0) - anyK) * (reduce ? 1 : 0.14);
    hintK += ((active ? 0 : 1) - hintK) * 0.08;

    ctx.clearRect(0, 0, w, h);
    grid();
    for (const q of particles) {
      if (!reduce) { q.x -= q.s; q.y += q.s * 0.12; }
      if (q.x < -5) q.x = w + 5; if (q.y > h + 5) q.y = -5;
      ctx.fillStyle = `rgba(${A},${q.a})`; ctx.beginPath(); ctx.arc(q.x, q.y, q.r, 0, Math.PI * 2); ctx.fill();
    }
    const Lo = layout();
    drawSnake(t, Lo.snake);
    drawBird(t, Lo.bird);
    drawJig(t, Lo.jig);
    noGlow();
    for (const id of IDS) label(id);

    if (!Lo.mobile && hintK > 0.02) {
      ctx.save(); ctx.globalAlpha = 0.55 * hintK; ctx.fillStyle = '#9098a5';
      ctx.font = '500 11px "JetBrains Mono", monospace';
      const txt = '↖  ' + hint.toUpperCase();
      ctx.fillText(txt, Lo.snake.x - Lo.snake.len * 0.45, Lo.snake.y + 95); ctx.restore();
    }
    if (running && !reduce) raf = requestAnimationFrame(frame);
  }

  // ---------- interaction ----------
  function hit(px: number, py: number): Id | null {
    for (const id of ['jig', 'bird', 'snake'] as Id[]) { const b = boxes[id]; if (b && px >= b.x0 && px <= b.x1 && py >= b.y0 && py <= b.y1) return id; }
    return null;
  }
  const local = (e: PointerEvent) => { const r = canvas.getBoundingClientRect(); return [e.clientX - r.left, e.clientY - r.top] as const; };
  canvas.addEventListener('pointermove', (e) => {
    if (e.pointerType === 'touch') return;
    const [x, y] = local(e); hovered = hit(x, y); canvas.style.cursor = hovered ? 'pointer' : 'default';
    if (reduce) frame(performance.now());
  });
  canvas.addEventListener('pointerleave', () => { hovered = null; canvas.style.cursor = 'default'; if (reduce) frame(performance.now()); });
  canvas.addEventListener('click', (e) => {
    const [x, y] = local(e as PointerEvent); const id = hit(x, y);
    if (!id) { hovered = null; return; }
    const touch = (e as PointerEvent).pointerType === 'touch' || matchMedia('(hover: none)').matches;
    if (touch && hovered !== id) { hovered = id; if (reduce) frame(performance.now()); return; }   // first tap: preview
    window.location.href = meta[id].href;
  });
  // "Explore" links in the hero text highlight the matching machine.
  document.querySelectorAll<HTMLElement>('[data-scene]').forEach((el) => {
    const id = el.dataset.scene as Id;
    el.addEventListener('mouseenter', () => { external = id; if (reduce) frame(performance.now()); });
    el.addEventListener('mouseleave', () => { external = null; if (reduce) frame(performance.now()); });
    el.addEventListener('focus', () => { external = id; });
    el.addEventListener('blur', () => { external = null; });
  });

  function start() { if (running) return; running = true; raf = requestAnimationFrame(frame); }
  function stop() { running = false; cancelAnimationFrame(raf); }
  resize();
  new ResizeObserver(() => { resize(); if (reduce) frame(performance.now()); }).observe(canvas);
  document.fonts?.ready.then(() => reduce && frame(performance.now()));
  if (reduce) frame(performance.now());
  else {
    new IntersectionObserver(([en]) => (en.isIntersecting ? start() : stop())).observe(canvas);
    document.addEventListener('visibilitychange', () => (document.hidden ? stop() : start()));
  }
</script>

<style>
  .scene { position: absolute; inset: 0; width: 100%; height: 100%; touch-action: manipulation; }
</style>
