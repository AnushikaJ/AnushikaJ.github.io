---
// Blueprint-style animation of a 9-link underwater snake robot (ACM-R5 layout).
// Joint angles follow a serpenoid gait: phi_i(t) = alpha * sin(omega*t + i*beta).
---

<canvas class="snake-canvas" aria-hidden="true"></canvas>

<script>
  const canvas = document.querySelector<HTMLCanvasElement>('.snake-canvas')!;
  const ctx = canvas.getContext('2d')!;
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  const N = 9;              // links
  const ALPHA = 0.42;       // joint amplitude [rad]
  const BETA = 0.78;        // phase offset between joints [rad]
  const OMEGA = 1.25;       // gait frequency [rad/s]
  const ACCENT = '111,183,255';

  let w = 0, h = 0, dpr = 1, running = false, raf = 0, t0 = performance.now();
  const particles: { x: number; y: number; r: number; s: number; a: number }[] = [];
  const trail: { x: number; y: number }[] = [];

  function resize() {
    const r = canvas.getBoundingClientRect();
    dpr = Math.min(window.devicePixelRatio || 1, 2);
    w = r.width; h = r.height;
    canvas.width = Math.round(w * dpr); canvas.height = Math.round(h * dpr);
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    particles.length = 0;
    const count = Math.round((w * h) / 22000);
    for (let i = 0; i < count; i++) {
      particles.push({ x: Math.random() * w, y: Math.random() * h, r: Math.random() * 1.2 + 0.3, s: Math.random() * 0.5 + 0.2, a: Math.random() * 0.35 + 0.08 });
    }
    trail.length = 0;
  }

  function grid() {
    const step = 44;
    ctx.lineWidth = 1;
    for (let x = 0, i = 0; x < w; x += step, i++) {
      ctx.strokeStyle = i % 5 === 0 ? 'rgba(255,255,255,0.045)' : 'rgba(255,255,255,0.022)';
      ctx.beginPath(); ctx.moveTo(x + 0.5, 0); ctx.lineTo(x + 0.5, h); ctx.stroke();
    }
    for (let y = 0, i = 0; y < h; y += step, i++) {
      ctx.strokeStyle = i % 5 === 0 ? 'rgba(255,255,255,0.045)' : 'rgba(255,255,255,0.022)';
      ctx.beginPath(); ctx.moveTo(0, y + 0.5); ctx.lineTo(w, y + 0.5); ctx.stroke();
    }
  }

  function capsule(ax: number, ay: number, bx: number, by: number, r: number) {
    const len = Math.hypot(bx - ax, by - ay);
    const ang = Math.atan2(by - ay, bx - ax);
    ctx.save(); ctx.translate(ax, ay); ctx.rotate(ang);
    ctx.beginPath();
    ctx.moveTo(0, -r); ctx.lineTo(len, -r);
    ctx.arc(len, 0, r, -Math.PI / 2, Math.PI / 2);
    ctx.lineTo(0, r);
    ctx.arc(0, 0, r, Math.PI / 2, (3 * Math.PI) / 2);
    ctx.closePath();
    ctx.fillStyle = `rgba(${ACCENT},0.045)`; ctx.fill();
    ctx.strokeStyle = `rgba(${ACCENT},0.8)`; ctx.lineWidth = 1.2; ctx.stroke();
    // centre line
    ctx.setLineDash([3, 5]); ctx.strokeStyle = `rgba(${ACCENT},0.28)`; ctx.lineWidth = 1;
    ctx.beginPath(); ctx.moveTo(0, 0); ctx.lineTo(len, 0); ctx.stroke(); ctx.setLineDash([]);
    ctx.restore();
  }

  function frame(now: number) {
    const t = reduce ? 2.1 : (now - t0) / 1000;
    ctx.clearRect(0, 0, w, h);
    grid();

    const mobile = w < 760;
    const total = Math.min(mobile ? w * 0.8 : w * 0.42, 600);
    const L = total / N;
    const r = Math.max(7, L * 0.2);

    // Forward kinematics from head (i = 0) backwards along the body.
    const pts: { x: number; y: number }[] = [{ x: 0, y: 0 }];
    let th = 0;
    for (let i = 0; i < N; i++) {
      if (i > 0) th += ALPHA * Math.sin(OMEGA * t + i * BETA);
      const p = pts[i];
      pts.push({ x: p.x - L * Math.cos(th), y: p.y - L * Math.sin(th) });
    }
    // Re-centre: rotate so the mean body axis points along the swim heading.
    const cx = pts.reduce((s, p) => s + p.x, 0) / pts.length;
    const cy = pts.reduce((s, p) => s + p.y, 0) / pts.length;
    const tail = pts[pts.length - 1];
    const axis = Math.atan2(pts[0].y - tail.y, pts[0].x - tail.x);
    const heading = -0.12 + 0.05 * Math.sin(t * 0.21);
    const rot = heading - axis;
    const ax = mobile ? w * 0.5 : w * 0.74;
    const ay = (mobile ? Math.min(h * 0.3, window.innerHeight * 0.27) : h * 0.5) + Math.sin(t * 0.33) * 12;
    const P = pts.map((p) => {
      const x = p.x - cx, y = p.y - cy;
      return { x: ax + x * Math.cos(rot) - y * Math.sin(rot), y: ay + x * Math.sin(rot) + y * Math.cos(rot) };
    });

    // Particles drift backwards relative to the swim direction.
    const dx = -Math.cos(heading), dy = -Math.sin(heading);
    for (const q of particles) {
      if (!reduce) { q.x += dx * q.s; q.y += dy * q.s; }
      if (q.x < -5) q.x = w + 5; if (q.x > w + 5) q.x = -5;
      if (q.y < -5) q.y = h + 5; if (q.y > h + 5) q.y = -5;
      ctx.fillStyle = `rgba(${ACCENT},${q.a})`;
      ctx.beginPath(); ctx.arc(q.x, q.y, q.r, 0, Math.PI * 2); ctx.fill();
    }

    // Head trajectory trace.
    trail.push({ x: P[0].x, y: P[0].y });
    if (trail.length > 160) trail.shift();
    if (trail.length > 2) {
      ctx.setLineDash([2, 6]); ctx.strokeStyle = `rgba(${ACCENT},0.22)`; ctx.lineWidth = 1;
      ctx.beginPath(); trail.forEach((p, i) => (i ? ctx.lineTo(p.x, p.y) : ctx.moveTo(p.x, p.y))); ctx.stroke(); ctx.setLineDash([]);
    }

    // Links (slightly shorter than pitch so the joints read clearly).
    for (let i = 0; i < N; i++) {
      const a = P[i], b = P[i + 1];
      const gx = (b.x - a.x) * 0.16, gy = (b.y - a.y) * 0.16;
      capsule(a.x + gx, a.y + gy, b.x - gx, b.y - gy, r);
    }
    // Joints.
    for (let i = 1; i < N; i++) {
      ctx.beginPath(); ctx.arc(P[i].x, P[i].y, r * 0.5, 0, Math.PI * 2);
      ctx.fillStyle = '#0a0c0f'; ctx.fill();
      ctx.strokeStyle = `rgba(${ACCENT},0.9)`; ctx.lineWidth = 1.2; ctx.stroke();
      ctx.beginPath(); ctx.arc(P[i].x, P[i].y, 1.4, 0, Math.PI * 2); ctx.fillStyle = `rgba(${ACCENT},0.9)`; ctx.fill();
    }
    // Head marker + annotations.
    const H = P[0];
    ctx.strokeStyle = `rgba(${ACCENT},0.5)`; ctx.lineWidth = 1;
    ctx.beginPath(); ctx.arc(H.x, H.y, r * 1.9, 0, Math.PI * 2); ctx.stroke();
    ctx.beginPath(); ctx.moveTo(H.x - r * 2.6, H.y); ctx.lineTo(H.x + r * 2.6, H.y); ctx.moveTo(H.x, H.y - r * 2.6); ctx.lineTo(H.x, H.y + r * 2.6); ctx.stroke();

    if (!mobile) {
      ctx.font = '500 11px "JetBrains Mono", monospace';
      const lx = H.x - r * 1.5 - 150, ly = H.y - r * 4.2;
      ctx.strokeStyle = `rgba(${ACCENT},0.35)`;
      ctx.beginPath(); ctx.moveTo(H.x - r * 1.4, H.y - r * 1.4); ctx.lineTo(lx + 150, ly + 4); ctx.lineTo(lx - 4, ly + 4); ctx.stroke();
      ctx.fillStyle = 'rgba(232,234,237,0.62)';
      ctx.fillText('ACM-R5  ·  9 LINKS', lx, ly - 2);
      ctx.fillStyle = 'rgba(144,152,165,0.7)';
      ctx.fillText(`φᵢ(t) = α·sin(ωt + iβ)     t = ${t.toFixed(2)} s`, ax - total * 0.45, ay + total * 0.36);
    }

    if (running && !reduce) raf = requestAnimationFrame(frame);
  }

  function start() { if (running) return; running = true; raf = requestAnimationFrame(frame); }
  function stop() { running = false; cancelAnimationFrame(raf); }

  resize();
  new ResizeObserver(() => { resize(); if (reduce) frame(performance.now()); }).observe(canvas);
  if (reduce) { frame(performance.now()); }
  else {
    new IntersectionObserver(([e]) => (e.isIntersecting ? start() : stop())).observe(canvas);
    document.addEventListener('visibilitychange', () => (document.hidden ? stop() : start()));
  }
</script>

<style>
  .snake-canvas { position: absolute; inset: 0; width: 100%; height: 100%; }
</style>
